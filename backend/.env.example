# TaskFlow Backend Environment Configuration

# Server
PORT=8080
ENV=development # development | staging | production
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (PostgreSQL + pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_USER=taskflow
DB_PASSWORD=taskflow_secret
DB_NAME=taskflow_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=super-secret-jwt-token-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRY_MINUTES=15
JWT_REFRESH_EXPIRY_DAYS=7

# Groq AI Provider (Phase 4: RAG Subtasks)
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_EMBEDDING_MODEL=nomic-embed-text-v1_5

